<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Internet & Firestore -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permissions for GPS / Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_student_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_student_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentBuddy">

        <!-- 1. Main Launcher & Login Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Dashboard Screen -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- 3. Registration Screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- 4. Profile Screen -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- 5. Calculator Screen -->
        <activity
            android:name=".CalculatorActivity"
            android:exported="false" />

        <!-- 6. Study Timer Screen -->
        <activity
            android:name=".StudyTimerActivity"
            android:exported="false" />

        <!-- 7. Notes Screen -->
        <activity
            android:name=".NotesActivity"
            android:exported="false" />

        <!-- 8. Location Screen -->
        <activity
            android:name=".LocationActivity"
            android:exported="false" />

        <!-- 9. About Screen -->
        <activity
            android:name=".AboutActivity"
            android:exported="false" />

    </application>

</manifest>
